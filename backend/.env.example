PORT=5000
NODE_ENV=development
# Required on Render: add this under Environment → Environment Variables
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Delete server audio files older than this (uploads/ + outputs/)
AUDIO_RETENTION_HOURS=6

# Render automatically injects RENDER_EXTERNAL_URL — used for keep-alive self-ping.
# No need to set this manually on Render; it is set automatically.
# Example: https://dummy-mobileapp.onrender.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
